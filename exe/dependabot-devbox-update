#!/usr/bin/env ruby
# frozen_string_literal: true

require "logger"
require "dependabot/logger"
require "dependabot/devbox"

Dependabot.logger = Logger.new($stdout, formatter: ->(_severity, _time, _progname, msg) { "#{msg}\n" })

begin
  config = Dependabot::Devbox::UpdateRunner::Config.from_env
  exit Dependabot::Devbox::UpdateRunner.run(config)
rescue Dependabot::Devbox::UpdateRunner::ConfigurationError => e
  warn "Configuration error: #{e.message}"
  exit 2
end
